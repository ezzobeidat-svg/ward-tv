   "updated": "2026-10-08T13:39:03.399Z"
  },
  {
   "type": "message",
   "text": "ביחד נתגבר על הקשיים",
   "text_ar": "معًا نتجاوز الصعاب",
   "text_en": "Together we overcome challenges",
   "important": false,
   "rec": "weekly",
   "days": [
    2
