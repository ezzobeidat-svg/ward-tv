   "updated": "2026-10-08T13:39:48.804Z"
  },
  {
   "type": "message",
   "text": "הבריאות הנפשית שלכם חשובה לנו",
   "text_ar": "صحتكم النفسية تهمّنا",
   "text_en": "Your mental health matters to us",
   "important": false,
   "rec": "weekly",
   "days": [
    3
   ],
   "start": "",
   "end": "",
   "id": "3luu9055s",
   "by": "Ezz Obedat",
   "updated": "2026-10-08T13:40:36.582Z"
  },
  {
   "type": "message",
   "text": "קחו נשימה עמוקה, אתם בטוחים כאן",
   "text_ar": "خذوا نفسًا عميقًا، أنتم في أمان هنا",
   "text_en": "Take a deep breath, you are safe here",
   "important": false,
   "rec": "daily",
   "days": [],
   "start": "",
   "end": "",
   "id": "4ot8ir0wt",
   "by": "Ezz Obedat",
   "updated": "2026-10-08T13:41:27.068Z"
  },
  {
   "type": "message",
   "text": "שתו מים, ישנו טוב, ודברו עם מי שאתם סומכים עליו",
   "text_ar": "اشربوا الماء، ناموا جيدًا، وتحدّثوا مع من تثقون به",
   "text_en": "Drink water, sleep well, and talk to someone you trust",
   "important": false,
   "rec": "daily",
   "days": [],
   "start": "",
   "end": "",
